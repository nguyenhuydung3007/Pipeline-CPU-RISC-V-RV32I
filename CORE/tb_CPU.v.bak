`timescale 1ns/1ps

module tb_CPU;

    // =========================
    // SIGNAL
    // =========================
    reg clk;
    reg reset;

    // =========================
    // DUT
    // =========================
    CPU dut (
        .clk(clk),
        .reset(reset)
    );

    // =========================
    // CLOCK 50MHz (20ns)
    // =========================
    always #10 clk = ~clk;

    // =========================
    // INITIAL
    // =========================
    initial begin
        clk = 0;
        reset = 1;

        // reset
        #50;
        reset = 0;

        // chạy ~2000 cycle
        #40000;

        $display("\n========== SIMULATION END ==========");
        $finish;
    end

    // =========================
    // HEADER LOG
    // =========================
    initial begin
        $display("=====================================================================================");
        $display("Time | PC | Instr | RegW | RD | Result | Stall | Flush | FwdA | FwdB | ALU | MemWrite");
        $display("=====================================================================================");
    end

    // =========================
    // MAIN LOG (mỗi cycle)
    // =========================
    always @(posedge clk) begin

        $display("%4t | %h | %h |  %b   | %2d | %h |   %b%b   |  %b%b   |  %b  |  %b  | %h |    %b",
            $time,

            // IF / ID
            dut.Fetch.PCF,
            dut.InstrD,

            // WB
            dut.RegWriteW_out,
            dut.RD_out,
            dut.ResultW,

            // Stall
            dut.StallF,
            dut.StallD,

            // Flush
            dut.FlushD,
            dut.FlushE,

            // Forward
            dut.ForwardA_E,
            dut.ForwardB_E,

            // ALU
            dut.ALU_ResultM_out,

            // Memory
            dut.MemWriteM
        );
    end

    // =========================
    // WRITEBACK EVENT LOG
    // =========================
    always @(posedge clk) begin
        if (dut.RegWriteW_out) begin
            $display(">>> WB: x%0d = %h", dut.RD_out, dut.ResultW);
        end
    end

    // =========================
    // BRANCH / FLUSH DEBUG
    // =========================
    always @(posedge clk) begin
        if (dut.PCSrcE)
            $display(">>> BRANCH TAKEN at time %0t", $time);

        if (dut.FlushD || dut.FlushE)
            $display(">>> PIPELINE FLUSH at time %0t", $time);
    end

    // =========================
    // STALL DEBUG
    // =========================
    always @(posedge clk) begin
        if (dut.StallF || dut.StallD)
            $display(">>> STALL at time %0t", $time);
    end

endmodule